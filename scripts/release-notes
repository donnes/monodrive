#!/usr/bin/env bash
# Writes a release's notes: a header, a list of what changed, and every commit
# folded under it. The updater reads everything before <details>. Commits land
# on main without PRs, so GitHub's generated notes would be empty.
#
#   scripts/release-notes <version> <previous tag or ""> <commit> <output>
#
# With OPENROUTER_API_KEY, Claude writes the list. Without it, or when the
# call fails, the feat, fix and perf subjects do.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ $# -ne 4 ]]; then
  echo "usage: scripts/release-notes <version> <previous tag or \"\"> <commit> <output>" >&2
  exit 2
fi
version=$1 previous=$2 commit=$3 output=$4
range=${previous:+$previous..}$commit

read -r -d '' instructions <<'PROMPT' || true
You write release notes for Monodrive, a fast file manager for macOS that replaces Finder, searches the whole disk, and gives coding agents the same index over MCP.

You get the commits since the last release, oldest first. Output a Markdown list and nothing else, one bullet a change, in exactly this shape:

- **Short title.** One sentence on what the user can do now, or what works now.

- Up to 7 bullets, the ones users will care about most first, new features before fixes. Fewer is fine. Never pad.
- The title names the feature or the place in the app in 1 to 3 words, in sentence case, with its period inside the bold.
- The sentence is plain and concrete, under 20 words. For a fix, say what works now, so a user who hit the bug recognizes it.
- One bullet can cover several commits about the same thing.

If user-facing fix, feat or perf commits are left out of the list, end with a blank line and then this line, with N the number of them:

**Plus N more bug fixes and improvements.**

For just one, write **Plus 1 more bug fix or improvement.**

Pick only significant, user-facing changes. Leave out visual polish, refactors, tests, CI, build, docs and plans. Say what the user gets, as short as possible. No internal names, file paths or code terms. No em dashes. No hype words. Do not invent anything that is not in the input.
PROMPT

# The model's summary, or nothing if it can't be had.
summarize() {
  [[ -n "${OPENROUTER_API_KEY:-}" ]] || return 0
  local request response
  request=$(jq -n --arg system "$instructions" --arg commits "$1" '{
    model: "anthropic/claude-opus-5.5",
    max_tokens: 16000,
    reasoning: {effort: "low"},
    messages: [
      {role: "system", content: $system},
      {role: "user", content: ("Commits:\n" + $commits)}
    ]
  }')
  response=$(curl --fail-with-body --silent --show-error --max-time 180 \
    https://openrouter.ai/api/v1/chat/completions \
    --header "Content-Type: application/json" \
    --header "Authorization: Bearer $OPENROUTER_API_KEY" \
    --data "$request") || {
    echo "::warning::Couldn't write the summary: $response" >&2
    return 0
  }
  # A response that stopped early would cut the notes short.
  jq -r '.choices[0] | select(.finish_reason == "stop") | .message.content // empty' <<<"$response" || true
}

sentence() { awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }'; }

# The same list from the subjects alone, features first.
from_subjects() {
  local subjects noticed more
  subjects=$(git log --reverse --format=%s "$range")
  noticed=$({
    sed -nE 's/^feat(\([^)]*\))?!?: //p' <<<"$subjects"
    sed -nE 's/^(fix|perf)(\([^)]*\))?!?: //p' <<<"$subjects"
  } | sentence | sed -E 's/ \(#[0-9]+\)$//; s/^/- /; s/$/./')
  [[ -n "$noticed" ]] || return 0
  head -n 7 <<<"$noticed"
  more=$(($(wc -l <<<"$noticed") - 7))
  if ((more == 1)); then
    printf '\n**Plus 1 more bug fix or improvement.**\n'
  elif ((more > 1)); then
    printf '\n**Plus %s more bug fixes and improvements.**\n' "$more"
  fi
}

plural() { if [[ $1 == 1 ]]; then echo "$1 $2"; else echo "$1 ${2}s"; fi; }

changes=$(git rev-list --count "$range")
contributors=$(git log --format=%an "$range" | { grep -v '\[bot\]$' || true; } | sort -u | wc -l | tr -d ' ')
commits=$(git log --reverse --format='%s%n%w(0,2,2)%b' "$range")
summary=$(summarize "$commits")
if [[ -z "$summary" ]]; then
  summary=$(from_subjects)
fi

# Publishing uses the file when it exists, so never leave half of one.
{
  printf '**v%s** · %s from %s\n\n' "$version" "$(plural "$changes" change)" "$(plural "$contributors" contributor)"
  if [[ -n "$summary" ]]; then
    printf '%s\n\n' "$summary"
  fi
  printf '<details>\n<summary>Full changelog</summary>\n\n'
  git log --reverse --format='- %s (%h)' "$range"
  printf '\n</details>\n'
} >"$output.tmp"
mv "$output.tmp" "$output"
