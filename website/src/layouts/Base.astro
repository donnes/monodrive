---
import "../styles/global.css";
import { markSvg } from "../lib/icons";
import { formatStars, githubStars } from "../lib/github";

interface Props {
  title: string;
}

const { title } = Astro.props;
const RELEASES = "https://github.com/donnes/monodrive/releases";
const REPO = "https://github.com/donnes/monodrive";
const stars = await githubStars();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Monodrive is a fast, native file manager for macOS that your coding agents can use too." />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Monodrive home">
          <span class="brand-icon" set:html={markSvg(13)} />
          <span>Monodrive</span>
        </a>
        <nav class="nav-links">
          {
            stars === null ? (
              <a href={REPO} class="nav-stars">
                GitHub
              </a>
            ) : (
              <a href={REPO} class="nav-stars" aria-label={`Star Monodrive on GitHub, ${stars} stars`}>
                <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.3l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.12l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.3z" fill="currentColor" />
                </svg>
                <span>
                  <b>{formatStars(stars)}</b> GitHub {stars === 1 ? "star" : "stars"}
                </span>
              </a>
            )
          }
          <a href={RELEASES} class="nav-cta">Download</a>
        </nav>
      </div>
    </header>

    <slot />

    <script>
      // The header's buttons stay away while the hero's own ([data-cta]) are on
      // screen, so the page never shows two Download buttons at once.
      const header = document.querySelector<HTMLElement>(".nav")!;
      const cta = document.querySelector("[data-cta]");
      if (cta) {
        new IntersectionObserver(([entry]) => {
          header.toggleAttribute("data-show", !entry.isIntersecting && entry.boundingClientRect.top < 0);
        }).observe(cta);
      }
      const edge = () => header.toggleAttribute("data-scrolled", scrollY > 4);
      addEventListener("scroll", edge, { passive: true });
      edge();
    </script>

    <style>
      /* A glass bar inset from the edges. It stays clear over the empty top of
         the page and turns to glass once content scrolls under it, so the
         material only shows where it separates something. */
      .nav {
        position: fixed;
        z-index: 40;
        top: 12px;
        left: 50%;
        translate: -50% 0;
        width: min(1168px, 100% - 24px);
        border-radius: 18px;
        background: rgb(24 24 27 / 0);
        backdrop-filter: blur(0) saturate(100%);
        -webkit-backdrop-filter: blur(0) saturate(100%);
        box-shadow:
          inset 0 0 0 1px rgb(255 255 255 / 0),
          0 10px 30px rgb(0 0 0 / 0);
        transition:
          background-color 240ms ease,
          backdrop-filter 240ms ease,
          -webkit-backdrop-filter 240ms ease,
          box-shadow 240ms ease;
      }
      .nav[data-scrolled] {
        background: rgb(24 24 27 / 0.62);
        backdrop-filter: blur(22px) saturate(180%);
        -webkit-backdrop-filter: blur(22px) saturate(180%);
        box-shadow:
          inset 0 1px 0 rgb(255 255 255 / 0.09),
          inset 0 0 0 1px rgb(255 255 255 / 0.06),
          0 10px 30px rgb(0 0 0 / 0.35);
      }
      @media (prefers-reduced-transparency: reduce) {
        .nav[data-scrolled] {
          background: #18181a;
          backdrop-filter: none;
          -webkit-backdrop-filter: none;
        }
      }
      .nav-inner {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px 0 16px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 620;
        letter-spacing: -0.01em;
      }
      .brand-icon {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        border-radius: 6px;
        background: #000;
        color: #fff;
        box-shadow:
          inset 0 0 0 1px rgb(255 255 255 / 0.16),
          inset 0 0 4px rgb(255 255 255 / 0.12);
      }

      /* Out of the way, the buttons wait 6 pt up and fade in when the hero's leave. */
      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        opacity: 0;
        translate: 0 -6px;
        visibility: hidden;
        transition:
          opacity 150ms ease-out,
          translate 150ms var(--ease-out),
          visibility 0s linear 150ms;
      }
      .nav[data-show] .nav-links {
        opacity: 1;
        translate: 0 0;
        visibility: visible;
        transition:
          opacity 200ms ease-out,
          translate 200ms var(--ease-out),
          visibility 0s;
      }
      .nav-stars {
        height: 36px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 0 12px;
        border-radius: 999px;
        font-size: 13px;
        color: var(--ink-65);
        white-space: nowrap;
        transition:
          color 160ms ease,
          background-color 160ms ease;
      }
      .nav-stars svg {
        color: #febc2e;
        flex: none;
      }
      .nav-stars b {
        font-weight: 600;
        color: var(--ink-1);
        font-variant-numeric: tabular-nums;
      }
      .nav-cta {
        height: 36px;
        display: inline-flex;
        align-items: center;
        padding: 0 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 560;
        background: #f4f4f2;
        color: #0b0b0c;
        transition:
          background-color 160ms ease,
          transform 160ms var(--ease-out);
      }
      .nav-cta:active {
        transform: scale(0.97);
      }
      @media (hover: hover) and (pointer: fine) {
        .nav-stars:hover {
          color: var(--ink-1);
          background: var(--ink-06);
        }
        .nav-cta:hover {
          background: #fff;
        }
      }
    </style>
  </body>
</html>
